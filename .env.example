# Home Assistant: used to switch the LED ring on/off
HA_URL=https://homeassistant.local:8123
HA_TOKEN=
LED_ENTITY=light.meter_cam_led
LED_BRIGHTNESS_PCT=60

# Camera snapshot URL (returns one JPEG per request)
CAMERA_URL=http://camera.local:8081/

# MQTT broker; leave MQTT_URL empty for a dry run (log only)
MQTT_URL=mqtt://broker.local:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=homeassistant
